        except Exception:
            continue
        if d.shape[1] < 2: continue
        d = d.iloc[:, :2].copy(); d.columns = ["pid", "diagnosis"]
        d = d[pd.to_numeric(d["pid"], errors="coerce").notna()]
        if len(d) >= 50:                                      # ~126 patient thakar kotha
            d["pid"] = d["pid"].astype(int); d["diagnosis"] = d["diagnosis"].astype(str).str.strip()
            print("Diagnosis file:", f, "->", len(d), "patients")
            return d
    print("WARNING: diagnosis file paoa jai nai, diagnosis = 'Unknown' hobe")
    return pd.DataFrame(columns=["pid", "diagnosis"])


