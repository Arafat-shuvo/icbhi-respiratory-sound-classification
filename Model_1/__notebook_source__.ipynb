def fix_length(x, n):
    if len(x) >= n:
        s = (len(x) - n) // 2
        return x[s:s + n]
    return np.tile(x, int(np.ceil(n / len(x))))[:n]


def norm_wave(x):
    x = x - x.mean()
    return x / (np.abs(x).max() + 1e-8)


